{
  "name": "jambagecom/tt-board",
  "type": "typo3-cms-extension",
  "description": "Simple threaded (tree) or list message board (forum).",
  "keywords": [
    "TYPO3",
    "extension",
    "forum",
    "message",
    "board"
  ],
  "support": {
    "issues": "https://github.com/franzholz/tt_board/issues"
  },
  "homepage": "https://jambage.com",
  "authors": [
    {
      "name": "Franz Holzinger",
      "role": "Developer",
      "homepage": "https://ttproducts.de"
    }
  ],
  "license": [
    "GPL-2.0-or-later"
  ],
  "require": {
    "php": ">=8.2.0",
    "ext-pdo": "*",
    "typo3/cms-core": "^13.4.15 || ^14",
    "typo3/cms-extensionmanager": "^13.4.15 || ^14",
    "typo3/cms-felogin": "^13.4.15 || ^14",
    "typo3/cms-filemetadata": "^13.4.15 || ^14",
    "typo3/cms-tstemplate": "^13.4.15 || ^14",
    "jambagecom/div2007": "^2.4.2",
    "jambagecom/tslib-fetce": "^0.11"
  },
  "autoload": {
    "psr-4": {
      "JambageCom\\TtBoard\\": "Classes"
    }
  },
  "suggest": {
    "friendsoftypo3/sys-action": "^13.0 || ^14",
    "friendsoftypo3/taskcenter": "^13.0 || ^14",
    "sjbr/sr-freecap": "^13.4 || ^14",
    "internetgalerie/ig-slug": "^1.1"
  },
  "replace": {
    "typo3-ter/tt-board": "self.version"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "tt_board",
      "version": "1.18.9",
      "Package": {
          "providesPackages": {}
      }
    }
  }
}
